  },
  "definitions_and_denominators": {
    "repair_success_rate": "Proportion of eligible repair tasks where the intended issue is correctly resolved without new regressions. Denominator = eligible repair cases only (expected_repairable == True). Excludes clean valid code and unfixable cases.",
    "exact_match_rate": "Proportion of generated patches identical (whitespace-normalized) to the human-curated reference patch. Reported strictly separately from semantic repair success. Denominator = eligible repair cases.",
    "validation_pass_rate": "Proportion of candidate patches passing all specified validation checks (syntax parse, AST integrity, compilation, test suite, and security verification). Denominator = total candidate patches generated.",
    "regression_rate": "Proportion of evaluated cases where a patch introduced new syntax, semantic, or security errors, or modified clean valid programs destructively. Denominator = total evaluated benchmark cases.",
    "security_precision": "True Positives / (True Positives + False Positives) for supported CWE vulnerability detection.",
    "security_recall": "True Positives / (True Positives + False Negatives) for supported CWE vulnerability detection.",
    "error_false_positive_rate": "Proportion of clean valid programs falsely identified as having errors or modified by repair. FPR = FP / (FP + TN). Denominator = clean valid cases.",
    "error_false_negative_rate": "Proportion of buggy programs where the error was completely missed. FNR = FN / (FN + TP). Denominator = error cases.",
    "energy_per_successful_repair": "Total energy consumed by configuration in Joules divided by number of successfully validated repairs. Returns None if 0 successful repairs.",
    "fallback_effectiveness": "Proportion of cases escalating to the fallback model (Qwen2.5-Coder) that were successfully resolved after deterministic rules and specialized CodeT5 failed. Denominator = escalated fallback cases."
  },
  "epistemological_disclaimer": "BENCHMARK METHODOLOGY & LIMITATIONS DISCLAIMER: All benchmark metrics reflect empirical measurements on the fixed, labelled evaluation dataset. Repair success is strictly distinguished from compilation success: a patch that compiles is NOT considered successful unless semantic intent and security constraints are satisfied. Model confidence values are NEVER used as proof of correctness. Initial benchmark status is UNBENCHMARKED until empirical test executions complete. Energy consumption is estimated via hardware linear TDP models (psutil/torch) as documented in the Green Metrics Engine."
}